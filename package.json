{
  "name": "cablesync",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "node backend/seed.js",
    "build": "npm --prefix frontend run build",
    "start": "node backend/server.js",
    "test:billing": "node --test backend/utils/billing.test.js",
    "lint": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
